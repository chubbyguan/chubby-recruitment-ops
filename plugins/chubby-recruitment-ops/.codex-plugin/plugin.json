    "shortDescription": "\u4ece\u62db\u8058\u5185\u5bb9\u3001\u7b80\u5386\u5230\u9762\u8bd5\u8bc4\u4ef7\u4e0e\u4eba\u5de5\u51b3\u7b56\u7684\u53ef\u5ba1\u8ba1\u95ed\u73af",
    "longDescription": "\u4e3a\u4e0d\u540c\u4e1a\u52a1\u90e8\u95e8\u521d\u59cb\u5316\u5e76\u8fd0\u884c\u793e\u4ea4\u62db\u8058\u95ed\u73af\uff1a\u6821\u9a8c\u5c97\u4f4d\u3001\u516c\u53f8\u4e0e\u85aa\u8d44\u5ba1\u6279\u4e8b\u5b9e\uff0c\u751f\u6210\u591a\u6e20\u9053\u5185\u5bb9\u5e76\u7ef4\u62a4\u4eba\u5de5\u53d1\u5e03\u961f\u5217\uff0c\u5904\u7406\u90ae\u7bb1\u7b80\u5386\uff0c\u6267\u884c\u53bb\u91cd\u3001\u5c97\u4f4d\u5339\u914d\u548c\u8bc1\u636e\u5316\u521d\u7b5b\uff1b\u4e3b\u52a8\u627e\u51fa\u9ad8\u5206\u3001\u6750\u6599\u5b8c\u6574\u4f46\u5c1a\u672a\u8fdb\u5165\u9762\u8bd5\u7684\u5019\u9009\u4eba\uff0c\u4ea4\u53c9\u6838\u9a8c\u9762\u8bd5\u8868\u548c\u98de\u4e66\u65e5\u5386\u540e\u53d1\u9001\u8131\u654f\u63a8\u8350\uff1b\u518d\u6838\u9a8c\u89c6\u9891\u4f1a\u8bae\u548c\u539f\u59cb\u7eaa\u8981\uff0c\u751f\u6210\u7ed3\u6784\u5316\u9762\u8bd5\u5efa\u8bae\u3001\u66b4\u9732\u7f3a\u5931\u6750\u6599\u548c\u8d85\u65f6\u51b3\u7b56\uff0c\u5199\u56de\u98de\u4e66 Base \u5e76\u751f\u6210\u65e5\u62a5\u3002\u53d1\u5e03\u3001\u5019\u9009\u4eba\u5f52\u5e76\u3001\u7ea6\u9762\u3001\u6dd8\u6c70\u3001\u9762\u8bd5\u7ed3\u8bba\u548c Offer \u59cb\u7ec8\u4fdd\u7559\u4eba\u5de5\u786e\u8ba4\u3002",
