{
  "schema_version": "2.0",
  "department_id": "replace-with-department-id",
  "timezone": "Asia/Shanghai",
  "company": {
    "public_name": "诺特兰德集团",
    "disclose_public_name": true,
    "legal_entity_source": "job_source"
  },
  "public_content": {
    "application_email": "jobs@example.com",
    "privacy_notice": "投递材料仅用于招聘评估；如只同意用于本岗位，请在邮件中注明。"
  },
  "compensation": {
    "source": "job_source",
    "public_range_field": "公开薪资范围",
    "approval_field": "薪资公开已批准",
    "approval_reference_field": "薪资审批记录",
    "require_approved_range": true,
    "fallback": "block_publication"
  },
  "channels": {
    "enabled": [
      "xiaohongshu",
      "wechat_groups",
      "zhihu"
    ],
    "supported": [
      "xiaohongshu",
      "wechat_moments",
      "wechat_groups",
      "wechat_official",
      "wechat_channels",
      "douyin",
      "bilibili",
      "zhihu",
      "maimai",
      "linkedin"
    ],
    "publish_mode": "manual",
    "metric_windows_hours": [
      24,
      72,
      168
    ]
  },
  "attribution": {
    "subject_code_required": true,
    "gmail_plus_alias": true,
    "allow_inferred_source": false
  },
  "connectors": {
    "email": {
      "provider": "gmail",
      "adapter": "auto",
      "account": "jobs@example.com",
      "inbox_query": "has:attachment newer_than:30d",
      "processed_label": "recruitment/processed"
    },
    "feishu": {
      "adapter": "auto",
      "base_app_token": "SET_LOCALLY",
      "digest_recipient_type": "open_id",
      "digest_recipient_id": "SET_LOCALLY",
      "tables": {
        "jobs": "SET_LOCALLY",
        "campaigns": "SET_LOCALLY",
        "content_variants": "SET_LOCALLY",
        "publications": "SET_LOCALLY",
        "metric_snapshots": "SET_LOCALLY",
        "attribution_codes": "SET_LOCALLY",
        "candidates": "SET_LOCALLY",
        "applications": "SET_LOCALLY",
        "application_stage_history": "SET_LOCALLY",
        "mail_log": "SET_LOCALLY",
        "automation_log": "SET_LOCALLY"
      }
    }
  },
  "job_policy": {
    "source": "feishu_base",
    "open_statuses": [
      "open",
      "招聘中"
    ],
    "conditional_statuses": [
      "conditional",
      "人才寻访",
      "条件岗"
    ],
    "blocked_statuses": [
      "frozen",
      "closed",
      "冻结",
      "关闭"
    ]
  },
  "schedule": {
    "inbox_hours": [
      9,
      11,
      13,
      15,
      17,
      19,
      21
    ],
    "digest_hour": 19,
    "enabled": false
  },
  "privacy": {
    "retention_days": 180,
    "authorized_reviewers": [],
    "store_resume_attachments_in_feishu": false,
    "redact_digest_contact_details": true
  },
  "controls": {
    "auto_publish_social_media": false,
    "auto_reject_candidate": false,
    "auto_invite_interview": false,
    "auto_send_offer": false,
    "auto_change_job_status": false
  }
}
