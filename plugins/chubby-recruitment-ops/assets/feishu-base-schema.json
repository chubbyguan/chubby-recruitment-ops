{
  "schema_version": "1.0",
  "tables": {
    "jobs": {
      "purpose": "岗位和编制唯一主数据",
      "required_fields": [
        "岗位ID",
        "岗位名称",
        "部门",
        "岗位状态",
        "Gate",
        "JD版本",
        "JD正文",
        "工作地点",
        "办公方式",
        "招聘Owner",
        "业务复核人",
        "30天结果",
        "60天结果",
        "90天结果",
        "硬要求",
        "作品要求",
        "一票否决"
      ],
      "stable_key": "岗位ID"
    },
    "candidates": {
      "purpose": "候选人唯一主数据",
      "required_fields": [
        "候选人唯一ID",
        "姓名",
        "候选阶段",
        "来源渠道",
        "邮件MessageID",
        "附件哈希",
        "明确投递岗位",
        "AI匹配Top1",
        "AI匹配Top2",
        "AI匹配Top3",
        "匹配置信度",
        "初筛总分",
        "初筛建议",
        "初筛证据摘要",
        "待补材料",
        "人工复核状态",
        "数据保留状态",
        "简历附件"
      ],
      "stable_key": "候选人唯一ID"
    },
    "interviews_offers": {
      "purpose": "面试、作业、Offer 和试用期事实",
      "required_fields": [
        "候选人唯一ID",
        "岗位ID",
        "面试轮次",
        "面试时间",
        "面试官",
        "案例作业",
        "结构化评分",
        "人工结论",
        "Offer状态"
      ],
      "stable_key": "面试记录ID"
    },
    "content_performance": {
      "purpose": "招聘内容版本、发布和渠道事实",
      "required_fields": [
        "内容ID",
        "岗位ID",
        "内容版本",
        "审批状态",
        "发布状态",
        "发布时间",
        "笔记URL",
        "阅读量",
        "点赞",
        "收藏",
        "评论",
        "归因投递",
        "有效候选",
        "指标状态"
      ],
      "stable_key": "内容ID"
    },
    "mail_log": {
      "purpose": "邮件处理和重试事实",
      "required_fields": [
        "邮件MessageID",
        "收到时间",
        "附件哈希",
        "处理状态",
        "候选人唯一ID",
        "错误原因",
        "重试次数"
      ],
      "stable_key": "邮件MessageID"
    },
    "automation_log": {
      "purpose": "每次任务运行事实",
      "required_fields": [
        "运行ID",
        "任务类型",
        "开始时间",
        "结束时间",
        "状态",
        "成功数",
        "跳过数",
        "失败数",
        "异常摘要"
      ],
      "stable_key": "运行ID"
    }
  }
}
